{
  // Static site on Cloudflare Workers (assets only, no server code).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pg-sathi-admin",
  "compatibility_date": "2026-10-01",
  // Keep the workers.dev address alive next to the custom domain.
  "workers_dev": true,
  // Needs pgsathi.online to be Active in Cloudflare before the next deploy.
  "routes": [{ "pattern": "app.pgsathi.online", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // Serve index.html for client-side routes like /app/residents/:id.
    "not_found_handling": "single-page-application"
  }
}
